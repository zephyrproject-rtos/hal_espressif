-    int cpuid = xPortGetCoreID();
-    uint32_t other_cpuid = (cpuid == 0) ? 1 : 0;
-#ifndef NDEBUG
-    // For sanity check later: record the CPU which has started doing flash operation
-    assert(s_flash_op_cpu == -1);
-    s_flash_op_cpu = cpuid;
